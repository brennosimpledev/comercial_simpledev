# === Supabase ===
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key (SERVER-ONLY, nunca exponha no client).
# Usado pelo webhook para inserir leads ignorando RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# === Webhook da Landing Page ===
# Segredo compartilhado. A LP deve enviar no header:  x-webhook-secret: <valor>
# Se ficar vazio, o webhook aceita qualquer requisicao (nao recomendado em producao).
LEAD_WEBHOOK_SECRET=troque-por-um-valor-aleatorio-forte

# === Evolution API (WhatsApp) ===
# Base da sua instancia Evolution (sem barra no final).
EVOLUTION_API_URL=https://evo.suaempresa.com
# Nome da instancia conectada ao numero de WhatsApp.
EVOLUTION_INSTANCE=simpledev
# API key da instancia (header apikey).
EVOLUTION_API_KEY=xxxxxxxx
# Segredo para validar o webhook de entrada da Evolution (opcional mas recomendado).
# Configure a Evolution para enviar header x-webhook-secret ou ?token=<valor>.
WHATSAPP_WEBHOOK_SECRET=troque-por-outro-valor-aleatorio

# === Cron (Vercel) ===
# Protege o endpoint /api/cron/followups. A Vercel envia como Bearer token.
CRON_SECRET=troque-por-mais-um-valor-aleatorio

# === Meta Lead Ads (webhook leadgen) ===
# Token que voce inventa e informa na config do webhook no Meta for Developers.
META_VERIFY_TOKEN=troque-por-um-token-de-verificacao
# Page Access Token de longa duracao (permissao leads_retrieval) para buscar o lead.
META_PAGE_ACCESS_TOKEN=EAAB...
# App Secret do app do Meta (valida a assinatura X-Hub-Signature-256). Opcional.
META_APP_SECRET=xxxxxxxx
# Versao da Graph API (opcional; padrao v21.0).
META_GRAPH_VERSION=v21.0

# === Google Calendar / Meet (OAuth) ===
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Deve bater exatamente com o Authorized redirect URI cadastrado no Google.
GOOGLE_REDIRECT_URI=https://comercial-simpledev.vercel.app/api/google/callback

# === Google Ads (conversoes offline) ===
# Central de APIs do Google Ads -> token de desenvolvedor (precisa de aprovacao).
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxx
# ID da conta do Google Ads, so digitos (ex: 123-456-7890 -> 1234567890).
GOOGLE_ADS_CUSTOMER_ID=1234567890
# Se a conta estiver sob uma MCC, o ID da MCC. Caso contrario, deixe vazio.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# IDs das acoes de conversao criadas no Google Ads (so o numero).
GOOGLE_ADS_ACTION_QUALIFICADO=
GOOGLE_ADS_ACTION_FECHADO=
# Valor atribuido a um lead qualificado (sinal economico para o Smart Bidding).
GOOGLE_ADS_VALOR_QUALIFICADO=200
# Valor usado quando o lead fecha sem valor_fechado preenchido.
GOOGLE_ADS_VALOR_FECHADO_PADRAO=0
# Versao da API. O Google desliga versoes antigas e a URL passa a devolver
# HTML 404. Para saber quais estao vivas:
#   curl -X POST -d {} https://googleads.googleapis.com/vNN/customers/1:uploadClickConversions
# Resposta JSON = viva; HTML = desligada.
GOOGLE_ADS_API_VERSION=v26
# Fuso da conta do Google Ads e o offset correspondente.
GOOGLE_ADS_TIMEZONE=America/Sao_Paulo
GOOGLE_ADS_TZ_OFFSET=-03:00
