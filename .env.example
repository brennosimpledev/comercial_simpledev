# === Supabase ===
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key (SERVER-ONLY, nunca exponha no client).
# Usado pelo webhook para inserir leads ignorando RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# === Webhook da Landing Page ===
# Segredo compartilhado. A LP deve enviar no header:  x-webhook-secret: <valor>
# Se ficar vazio, o webhook aceita qualquer requisicao (nao recomendado em producao).
LEAD_WEBHOOK_SECRET=troque-por-um-valor-aleatorio-forte

# === Evolution API (WhatsApp) ===
# Base da sua instancia Evolution (sem barra no final).
EVOLUTION_API_URL=https://evo.suaempresa.com
# Nome da instancia conectada ao numero de WhatsApp.
EVOLUTION_INSTANCE=simpledev
# API key da instancia (header apikey).
EVOLUTION_API_KEY=xxxxxxxx
# Segredo para validar o webhook de entrada da Evolution (opcional mas recomendado).
# Configure a Evolution para enviar header x-webhook-secret ou ?token=<valor>.
WHATSAPP_WEBHOOK_SECRET=troque-por-outro-valor-aleatorio

# === Cron (Vercel) ===
# Protege o endpoint /api/cron/followups. A Vercel envia como Bearer token.
CRON_SECRET=troque-por-mais-um-valor-aleatorio
