{
  "$ref": "#/definitions/plan",
  "definitions": {
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "scopeVersion": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "architecture": {
          "type": "string",
          "maxLength": 30000
        },
        "dataModel": {
          "type": "string",
          "maxLength": 30000
        },
        "permissions": {
          "type": "string",
          "maxLength": 30000
        },
        "integrations": {
          "type": "string",
          "maxLength": 30000
        },
        "testStrategy": {
          "type": "string",
          "maxLength": 30000
        },
        "weeklyCapacity": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "requirementIds": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/plan/properties/tasks/items/properties/id"
                }
              },
              "foundation": {
                "type": "boolean"
              },
              "category": {
                "type": "string",
                "enum": [
                  "planning",
                  "infrastructure",
                  "development",
                  "qa",
                  "security",
                  "deployment",
                  "validation"
                ]
              },
              "owner": {
                "type": "string",
                "maxLength": 200
              },
              "hours": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/plan/properties/tasks/items/properties/id"
                }
              },
              "start": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "end": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/plan/properties/tasks/items/properties/start/anyOf/0"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "todo",
                  "doing",
                  "review",
                  "blocked",
                  "done"
                ]
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/plan/properties/tasks/items/properties/title"
                }
              },
              "evidence": {
                "type": "string",
                "maxLength": 4000
              },
              "issueNumber": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pullNumber": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "title",
              "requirementIds",
              "foundation",
              "category",
              "owner",
              "hours",
              "dependencies",
              "start",
              "end",
              "status",
              "acceptance",
              "evidence",
              "issueNumber",
              "pullNumber"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 2000
        }
      },
      "required": [
        "schemaVersion",
        "scopeVersion",
        "architecture",
        "dataModel",
        "permissions",
        "integrations",
        "testStrategy",
        "weeklyCapacity",
        "tasks"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
